# Copy this file to .env and fill in real values.

# For local dev you can leave this as SQLite (no MySQL server needed):
DATABASE_URL=sqlite:///./dev.db

# To use MySQL (matches the project report's SRS), install/point at a MySQL
# server and use a URL like:
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/medidispense

# Generate a long random string for production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-dev-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Origins allowed to call the API from a browser (Next.js admin site).
CORS_ORIGINS=http://localhost:3000

# Path to a Firebase service-account JSON key file, used only to SEND FCM
# push notifications (free, no Firestore/Cloud Functions/Blaze plan needed).
# Leave blank to disable push and just log notifications to the console.
FIREBASE_SERVICE_ACCOUNT_PATH=
